{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youyou-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "vpnnew.net/api/analytics*",
      "zone_name": "vpnnew.net"
    },
    {
      "pattern": "www.vpnnew.net/api/analytics*",
      "zone_name": "vpnnew.net"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://vpnnew.net,http://127.0.0.1:8080,http://localhost:8080",
    "TIME_ZONE": "Asia/Shanghai"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youyou_analytics",
      "database_id": "d999c493-457b-4078-9a09-b5f7ca2ca400"
    }
  ]
}
